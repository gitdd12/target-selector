# 이 파일을 복사해 .env.local로 만들고 값을 채우세요. (.env.local은 git에 올라가지 않습니다.)

# Anthropic 콘솔(console.anthropic.com)에서 발급
# (변수명이 ANTHROPIC_API_KEY가 아니라 LLM_API_KEY인 이유: Claude Code 클라우드 세션 안에서 개발할 때
#  ANTHROPIC_API_KEY는 세션 자체가 예약해 쓰는 이름이라 충돌한다.)
LLM_API_KEY=

# Supabase 프로젝트 설정(Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 운영자 검토 화면(/review) 비밀번호
REVIEW_PASSWORD=

# 베타 참가 코드 (없으면 비워둠 = 링크를 아는 사람 누구나 시작 가능)
BETA_CODE=

# 결과지 아래에 표시할 문의 메일 주소
CONTACT_EMAIL=
